# Адрес CORS-прокси для входа в DTF (необязательно).
# В CI задаётся переменной репозитория VITE_AUTH_PROXY_URL.
VITE_AUTH_PROXY_URL=

# Резервный CORS-прокси на Cloudflare Workers (необязательно).
# В CI задаётся переменной репозитория VITE_CLOUDFLARE_PROXY_URL.
VITE_CLOUDFLARE_PROXY_URL=

# Адрес сервиса предпросмотра ссылок (Open Graph) для соцсетей (необязательно).
# В CI задаётся переменной репозитория VITE_SHARE_URL.
VITE_SHARE_URL=
