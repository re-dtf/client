{
	"name": "redtf",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"devDependencies": {
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"@vite-pwa/sveltekit": "^1.1.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"typescript": "^6.0.3",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@editorjs/code": "^2.9.4",
		"@editorjs/delimiter": "^1.4.2",
		"@editorjs/editorjs": "^2.31.7",
		"@editorjs/header": "^2.8.9",
		"@editorjs/image": "^2.10.3",
		"@editorjs/list": "^2.0.9",
		"@editorjs/quote": "^2.7.6",
		"dompurify": "^3.4.17",
		"lottie-web": "^5.13.0"
	},
	"overrides": {
		"@vite-pwa/sveltekit": {
			"@sveltejs/kit": "$@sveltejs/kit"
		},
		"glob": "^14.0.3",
		"minimatch": "^11.0.3"
	}
}
