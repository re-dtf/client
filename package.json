		"@editorjs/header": "^2.8.9",
		"@editorjs/image": "^2.10.3",
		"@editorjs/list": "^2.0.9",
		"@editorjs/quote": "^2.7.6",
		"dompurify": "^3.4.17",
		"lottie-web": "^5.13.0",
		"photoswipe": "^5.4.4"
	},
	"overrides": {
		"glob": "^14.0.3",
		"minimatch": "^11.0.4"
	}
